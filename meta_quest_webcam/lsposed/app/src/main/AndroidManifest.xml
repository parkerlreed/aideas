<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Forces UsbUserPermissionManager.hasPermission() true so UVC cameras and HDMI capture devices open on Meta Quest." />
        <!-- 93 = LSPosed / Xposed API 82 era. -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- Pre-selects System Framework in the LSPosed manager. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
